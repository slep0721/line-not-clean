# LINE Developers Console: Messaging API channel settings
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Gemini API (optional; if omitted or all models are overloaded, falls back to built-in rules)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Replace this with a random password of at least 20 characters.
ADMIN_PASSWORD=replace-this-with-a-long-random-password

PORT=3000
TIME_ZONE=Asia/Taipei
DATABASE_PATH=data/reservations.sqlite
CORS_ORIGINS=https://slep0721.github.io
